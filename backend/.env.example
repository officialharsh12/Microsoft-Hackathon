# ─── Review Intelligence — Backend Environment Config ──────────────────────────
# Copy this to .env and fill in your values.

# ── App ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (zero-setup, local)
DATABASE_URL=sqlite:///./data/reviews.db

# Switch to PostgreSQL (uncomment and fill in):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/reviews_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# Change this to a long random secret in production!
AUTH_SECRET=dev-secret-change-me-in-production

# ── Azure OpenAI (optional — LLM features) ───────────────────────────────────
LLM_PROVIDER=azure-openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── AI Models ────────────────────────────────────────────────────────────────
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
EMOTION_MODEL_NAME=SamLowe/roberta-base-go_emotions
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=32
DEVICE=auto
